{
  "name": "nestjs-vk",
  "version": "4.7.0",
  "description": "VK-IO module for NestJS",
  "homepage": "https://github.com/xTCry/nestjs-vk#readme",
  "bugs": {
    "url": "https://github.com/xTCry/nestjs-vk/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xTCry/nestjs-vk.git"
  },
  "license": "MIT",
  "author": "xTCry [Vladislav Kh] (https://github.com/xTCry/)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write \"lib/**/*.ts\"",
    "format:check": "prettier --check \"lib/**/*.ts\" \"test/**/*.ts\"",
    "format:sample": "prettier --config .prettierrc --write \"sample/*/src/**/*.ts\"",
    "copy-to-sample": "node scripts/copy-to-sample.js",
    "postbuild": "npm run copy-to-sample",
    "lint": "eslint \"lib/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "release": "release-it",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:patch": "release-it patch",
    "release:rc": "release-it --preRelease=rc",
    "prepare": "husky"
  },
  "dependencies": {
    "@vk-io/hear": "^1.1.0",
    "@vk-io/scenes": "^1.2.0",
    "@vk-io/session": "^2.2.0",
    "rimraf": "^6.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.39.2",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@release-it/conventional-changelog": "^12.0.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.17.21",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "middleware-io": "^2.8.1",
    "prettier": "3.7.4",
    "reflect-metadata": "0.2.2",
    "release-it": "^21.0.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vk-io": "^4.10.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^6.0.0 || ^7.2.0",
    "vk-io": "^4.10.0"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "git add -f"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "nest",
    "nestjs",
    "nestjs-module",
    "vk",
    "vk-io",
    "vk bot",
    "vk bot api",
    "bot",
    "bot api",
    "bot framework"
  ]
}

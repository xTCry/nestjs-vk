{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": false,
    "noLib": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2021",
    "sourceMap": false,
    "outDir": "./dist",
    "skipLibCheck": true
  },
  "include": ["lib/**/*", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
